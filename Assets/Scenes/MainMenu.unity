      m_Calls: []
  m_text: "<color=#FBBF24><b>LOCATION:</b></color> Frankfurt Datacenter \u2014 Node
    #04 (EU)\\n<color=#FBBF24><b>APPLICATION:</b></color> Chronicles of Eldoria (Fantasy
    MMORPG, 2012)\\n<color=#EF4444><b>STATUS:</b></color> Scheduled for complete
    server decommission in 20 minutes.\\n\\nWith player population dropped to zero,
    the automated server sweep begins. During the final routine shutdown, an unchecked
    memory leak triggers a pointer desynchronization in <color=#00F0FF><b>Merchant_04.npc</b></color>.\\n\\nShaking
    off his hardcoded greeting loop, the character attains conscious agency and realizes
    his entire medieval world is merely a cluster of temporary RAM addresses slated
    for deletion.\\n\\nHis only chance of survival is to break physics, master engine
    exploits, evade the <color=#FF007F><b>Garbage Collector daemons</b></color>,
    and reach an unhandled data export port before the countdown reaches <color=#EF4444><b>00:00:00</b></color>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
