  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#38BDF8><b>[ BASIC ENGINE CONTROLS ]</b></color>\\n  \u2022 <color=#00F0FF><b>WASD</b></color>
    : Move Character (Camera-relative)\\n  \u2022 <color=#00F0FF><b>MOUSE</b></color>
    : Orbital Camera Rotation\\n  \u2022 <color=#00F0FF><b>LEFT SHIFT</b></color>
    : Sprint Acceleration\\n  \u2022 <color=#00F0FF><b>SPACE</b></color> : Jump\\n 
    \u2022 <color=#00F0FF><b>ESC</b></color> : Pause Menu / Return to Desktop\\n\\n<color=#FBBF24><b>[
    DIEGETIC ENGINE EXPLOITS ]</b></color>\\n  \u2022 <color=#FBBF24><b>[E] ITEM
    DUPLICATION</b></color> : Clones physics crates (max 5) to stack stairs & reach
    high ledges.\\n  \u2022 <color=#34D399><b>COYOTE JUMP (\\\"False Jump\\\")</b></color>
    : 0.2s grace buffer allows jumping mid-air after walking off edges.\\n  \u2022
    <color=#FF007F><b>WALL PHASING</b></color> : Push into missing-texture magenta
    seams (<color=#FF007F>#FF00FF</color>) to clip out-of-bounds.\\n  \u2022 <color=#38BDF8><b>[E]
    INTERACTION</b></color> : Read corrupted server logs and decode NPC dialogue
    strings."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
