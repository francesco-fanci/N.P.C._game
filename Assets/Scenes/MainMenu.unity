  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>[ BASIC CONTROLS ]</b>\n  • <b>WASD</b>: Move Character (Camera-relative)\n  • <b>MOUSE</b>: Orbital Camera Rotation\n  • <b>LEFT SHIFT</b>: Sprint Acceleration\n  • <b>SPACE</b>: Jump\n  • <b>ESC</b>: Pause Menu\n\n<b>[ DIEGETIC ENGINE EXPLOITS ]</b>\n  • <b>[E] ITEM DUPLICATION</b>: Clones physics crates (cap: 5) to stack stairs & climb barriers.\n  • <b>COYOTE JUMP (\"False Jump\")</b>: 0.2s grace buffer allows jumping even after leaving ledges.\n  • <b>WALL PHASING</b>: Walk into untextured stone seams (#FF00FF) to clip out-of-bounds.\n  • <b>[E] INTERACTION</b>: Reads crash logs and inspects corrupted NPC dialogue.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
