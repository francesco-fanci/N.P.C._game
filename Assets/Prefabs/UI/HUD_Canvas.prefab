  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[ BASIC CONTROLS ]</b>\n  \u2022 <b>WASD</b>: Move Character (Camera-relative)\n 
    \u2022 <b>MOUSE</b>: Orbital Camera Rotation\n  \u2022 <b>LEFT SHIFT</b>: Sprint
    Acceleration\n  \u2022 <b>SPACE</b>: Jump\n\n<b>[ ENGINE EXPLOITS / GLITCHES
    ]</b>\n  \u2022 <b>[E] ITEM DUPLICATION</b>: Duplicates physics crates (cap:
    5) to build stairs & climb barriers.\n  \u2022 <b>COYOTE JUMP (\"False Jump\")</b>:
    0.2s grace buffer allows jumping even after leaving a ledge.\n  \u2022 <b>WALL
    PHASING</b>: Walk into untextured glitch seams (#FF00FF) to phase into unallocated
    space.\n  \u2022 <b>[E] INTERACTION</b>: Speaks to corrupted NPCs & reads developer
    crash logs."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
